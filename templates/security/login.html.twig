{% extends 'base-card.html.twig' %}

{% block title %}Log in! - Repman{% endblock %}

{% block card %}
<form class="card" method="post">
    <div class="card-body">
        <h1 class="mb-5 text-lg font-semibold">Login to your account</h1>

        {% include 'component/flash.html.twig' %}

        {% if error %}
            <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <p>
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
            </p>
        {% endif %}

        {% if oauth_enabled() %}
            {% include 'component/oauthButtons.html.twig' with {route_prefix: 'auth'} %}

            {% if localLoginEnabled %}
                <p class="my-4 flex items-center gap-3 text-xs text-slate-500 before:h-px before:flex-1 before:bg-slate-200 after:h-px after:flex-1 after:bg-slate-200">or sign in with e-mail</p>
            {% endif %}
        {% endif %}

        {% if localLoginEnabled %}
            <div class="form-row">
                <label for="inputEmail" class="form-label">Email address</label>
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" placeholder="Enter email" required autofocus autocomplete="username">
            </div>
            <div class="form-row">
                <div class="flex items-baseline justify-between">
                    <label for="inputPassword" class="form-label">Password</label>
                    <a href="{{ path('app_send_reset_password_link') }}" class="text-xs">I forgot password</a>
                </div>
                <input type="password" name="password" id="inputPassword" class="form-control" required autocomplete="current-password">
            </div>

            <div class="form-row">
                <label class="form-check">
                    <input type="checkbox" name="_remember_me"/>
                    Remember me
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-full">Sign in</button>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        {% endif %}
    </div>
</form>
{% include 'component/signUpLink.html.twig' %}
{% endblock %}
