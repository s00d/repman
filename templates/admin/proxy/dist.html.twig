{% extends "base.html.twig" %}

{% block header %}Downloaded packages - {{ proxy }}{% endblock %}

{% block content %}
<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Downloads count</th>
        <th>Last downloads</th>
        <th>Options</th>
    </tr>
    </thead>
    <tbody>
    {% for package in packages %}
        <tr>
            <td data-label="Name" data-card-title>{{ package }}</td>
            <td data-label="Downloads">{{ (downloads[package].downloads ?? 0)|number_format }}</td>
            <td data-label="Last download">
                {%- if downloads[package] is defined -%}
                    <span title="{{ downloads[package].lastDownload|date_time }} ({{ gmt_offset() }})">
                        {{ downloads[package].lastDownload|date_time|time_diff }}
                    </span>
                {%- endif -%}
            </td>
            <td>
                <button
                        class="btn btn-danger btn-sm"
                        type="button"
                        data-confirm-action="{{ path('admin_dist_remove', {packageName: package, proxy: proxy}) }}"
                        data-confirm-method="DELETE"
                >
                    Remove
                </button>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="4">No packages downloaded through this proxy yet</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% include 'component/pagination.html.twig' with {'path_name': 'admin_dist_list', 'path_params': {'proxy': proxy}} %}
</div>
{% endblock %}
