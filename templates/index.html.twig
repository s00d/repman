{% extends "base.html.twig" %}

{% block page %}
<main class="mx-auto max-w-7xl px-3 py-4 sm:px-4 sm:py-6">
    {% include 'component/flash.html.twig' %}

    {% if is_granted('ROLE_ADMIN') and showTelemetryPrompt %}
        {% include 'component/telemetryPrompt.html.twig' %}
    {% endif %}

    <div class="grid gap-6 lg:grid-cols-2">
        <section class="card">
            <div class="card-header">
                <h2 class="card-title">Proxy</h2>
            </div>
            <div class="card-body">
                <p>
                    Repman works as a proxy for packagist.org, speeding up your local builds. To speed up your build, use this Composer plugin:
                </p>
                <pre class="mb-3">composer global require repman-io/composer-plugin</pre>

                <p>You can also add these lines to your composer.json file:</p>

<pre class="mb-3">
{
    "repositories": [
        {"type": "composer", "url": "{{ url('proxy_repo_url') | trim('/') }}"},
        {"packagist": false}
    ]
}
</pre>
                <p>The last step is updating composer.lock:</p>
                <pre>composer update --lock</pre>
            </div>
        </section>
        <section class="card">
            <div class="card-header">
                <h2 class="card-title">Organizations</h2>
            </div>
            <div class="card-body">
                <p>
                    Organizations allow you to manage your private packages and the access to them.
                </p>
                {% if not app.user.belongsToAnyOrganization %}
                    <a href="{{ path('organization_create') }}" class="btn btn-success">Create a new organization</a>
                {% else %}
                    <ul class="mb-3 list-disc pl-6">
                    {% for org in app.user.organizations %}
                        <li><a href="{{ url('organization_overview', {"organization": org.alias}) }}">
                            {{ org.name }}
                        </a></li>
                    {% endfor %}
                    </ul>
                    <p>
                        <a href="{{ path('organization_create') }}">Create a new organization</a>
                    </p>
                {% endif %}
            </div>
        </section>
    </div>
</main>
{% endblock page %}
