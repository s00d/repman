{% extends 'base-card.html.twig' %}

{% block title %}Register - Repman{% endblock %}

{% block card %}
    <div class="card">
        <div class="card-body">

            {% include 'component/flash.html.twig' %}

            <h1 class="mb-5 text-center text-lg font-semibold">Sign up for free</h1>

            {% if oauthRegistrationEnabled and oauth_enabled() %}
                {% include 'component/oauthButtons.html.twig' with {route_prefix: 'register'} %}

                {% if localRegistrationEnabled %}
                    <p class="my-4 flex items-center gap-3 text-xs text-slate-500 before:h-px before:flex-1 before:bg-slate-200 after:h-px after:flex-1 after:bg-slate-200">or sign up with e-mail</p>
                {% endif %}
            {% endif %}

            {% if localRegistrationEnabled %}
                {{ form(registrationForm) }}
            {% endif %}

            <p class="mt-5 mb-0 text-center text-xs text-slate-500">
                By creating an account you agree to our <a href="https://repman.io/terms-of-service/" target="_blank" rel="noopener noreferrer">Terms & Conditions</a>.
            </p>
        </div>
    </div>
    <p class="mt-4 text-center text-slate-500">
        Already have an account? <a href="{{ url('app_login') }}">Sign in</a>
    </p>
{% endblock %}
