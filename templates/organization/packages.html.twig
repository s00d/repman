{% extends "base.html.twig" %}

{% block header_btn %}
    {% if is_granted('ROLE_ORGANIZATION_OWNER', organization) %}
        <a href="{{ url('organization_package_new', {"organization":organization.alias}) }}" class="btn btn-success">
            {% include 'svg/plus-square.svg' %} Add package
        </a>
    {% endif %}
{% endblock %}
{% block header %} {{ organization.name }} packages:{% endblock %}

{% block content %}
<form action="{{ path('organization_packages', {organization: organization.alias}) }}" method="get" class="mb-4 flex flex-wrap items-center gap-3">
    <div class="flex w-full items-center gap-2 sm:w-auto">
        <label for="package-search">Search:</label>
        <input type="search" id="package-search" name="search" value="{{ filter.searchTerm }}" class="form-control min-w-0 flex-1 sm:w-64" />
    </div>

    <label class="flex items-center gap-2 sm:ml-auto">
        Show
        <input type="number" name="limit" value="{{ filter.limit }}" class="form-control w-20" min="1" />
        entries
    </label>

    <button class="btn btn-secondary btn-sm">Filter</button>
</form>

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Name {% include 'component/sort.html.twig' with {column: 'name'} %}</th>
                <th>Latest version {% include 'component/sort.html.twig' with {column: 'version'} %}</th>
                <th>Released {% include 'component/sort.html.twig' with {column: 'date'} %}</th>
                <th>Description</th>
                {% if is_granted('ROLE_ORGANIZATION_MEMBER', organization) %}
                    <th class="text-center">Webhook</th>
                    <th class="text-center">Security</th>
                    <th><span class="sr-only">Actions</span></th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% for package in packages %}
                <tr>
                    <td>
                        {% if package.name %}
                            <a class="font-semibold" href="{{ path('organization_package_details', {organization: organization.alias, package: package.id}) }}">
                                {{ package.name }}
                            </a>
                            <a class="block max-w-64 truncate text-xs text-slate-500 italic" href="{{ package.url }}" title="{{ package.url }}" target="_blank" rel="nofollow noopener noreferrer">
                                {{ package.url }}
                            </a>
                            <span class="block text-xs text-slate-500 italic" title="{{ package.lastSyncAt|date_time }} ({{ gmt_offset() }})">synced: {{ package.lastSyncAt|date_time|time_diff }}</span>
                        {% elseif package.lastSyncError is null %}
                            Synchronizing from <a href="{{ package.url }}" target="_blank" rel="nofollow noopener noreferrer">
                                {{ package.url }}
                            </a>
                            <div class="indeterminate mt-2" role="progressbar" aria-label="Synchronizing"></div>
                        {% endif %}
                    </td>
                    <td data-label="Latest">{{ package.latestReleasedVersion }}</td>
                    <td data-label="Released" class="whitespace-nowrap">
                        {% if package.latestReleaseDate %}
                            <span title="{{ package.latestReleaseDate|date_time_utc }} ({{ gmt_offset() }})">{{ package.latestReleaseDate|date_time_utc|time_diff }}</span>
                        {% endif %}
                    </td>
                    <td data-label="Description">
                        {% if package.lastSyncError %}
                            <span class="badge badge-danger">Synchronization error</span>
                            <span class="text-xs text-slate-500 italic" title="{{ package.lastSyncAt|date_time }} ({{ gmt_offset() }})">{{ package.lastSyncAt|date_time|time_diff }}</span>
                            <div class="mt-1 max-h-40 overflow-auto rounded bg-slate-100 p-2 font-mono text-[0.7rem] break-all">
                                {{ package.lastSyncError | nl2br }}
                            </div>
                        {% else %}
                            {{ package.description|striptags }}
                        {% endif %}
                    </td>
                    {% if is_granted('ROLE_ORGANIZATION_MEMBER', organization) %}
                        <td data-label="Webhook" class="text-center">
                            {% if package.webhookCreatedAt is not empty %}
                                <span class="font-semibold" title="{{ package.webhookCreatedAt | date_time }} ({{ gmt_offset() }})">
                                    created
                                </span>
                            {% else %}
                                <small>N/A</small>
                            {% endif %}
                        </td>
                        <td data-label="Security" class="text-center">
                            {% if not package.isEnabledSecurityScan or package.isSynchronizedSuccessfully %}
                                {% include 'component/scanBadge.html.twig' %}
                            {% endif %}
                        </td>
                        <td class="text-right">
                            {% include 'component/packageActions.html.twig' %}
                        </td>
                    {% endif %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center">No packages found</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% include 'component/pagination.html.twig' with {'path_name': 'organization_packages', 'path_params': {'organization': organization.alias}} %}
{% endblock %}
