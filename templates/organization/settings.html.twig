{% extends "base.html.twig" %}

{% block header %} {{ organization.name }} settings:{% endblock %}

{% macro setting_form(form, field, button, buttonAttr) %}
    {{ form_start(form, {attr: {class: 'flex max-w-2xl flex-wrap items-start gap-3'}}) }}
        <div class="min-w-64 flex-1">
            {{ form_widget(form[field]) }}
            {{ form_errors(form[field]) }}
        </div>
        {{ form_widget(form[button], {attr: buttonAttr}) }}
    {{ form_end(form) }}
{% endmacro %}
{% import _self as settings %}

{% block content %}
    <h4>Organization name</h4>
    {{ settings.setting_form(renameForm, 'name', 'Rename', {}) }}
    <hr />

    <h4>Organization URL</h4>
    <p>
        Once you change the URL, you will have to change your Composer authorization config and composer.json.
    </p>
    {{ settings.setting_form(aliasForm, 'alias', 'Change', {class: 'btn-danger'}) }}
    <hr />

    <h4>Anonymous access</h4>
    <p>
        Enabling anonymous access allows to browse and download all organization packages.
    </p>
    {{ settings.setting_form(anonymousAccessForm, 'hasAnonymousAccess', 'changeAnonymousAccess', {class: 'btn-danger'}) }}
    <hr />

    <h4>Delete this organization</h4>
    <div class="flex max-w-2xl flex-wrap items-start justify-between gap-3">
        <p class="max-w-md">
            This action is irreversible. Once you delete an organization, it will not be possible to restore it.
        </p>
        <button
            class="btn btn-danger"
            type="button"
            data-confirm-action="{{ path('organization_remove', {organization: organization.alias }) }}"
            data-confirm-method="DELETE"
        >
            Delete
        </button>
    </div>
{% endblock %}
