{% extends 'organization/stats.html.twig' %}

{% block header %}
    {% include 'component/backToPackages.html.twig' %}
    <a href="{{ path('organization_package_details', {organization: organization.alias, package: package.id}) }}">{{ package.name }}</a>
    installs (last {{ days }} days)
{% endblock %}

{% block header_btn %}
    {{ parent() }}
    {% include 'component/packageActions.html.twig' %}
{% endblock %}

{% block content %}
    <h3>Daily installs</h3>
    {{ block('installs_chart') }}

    <hr />

    <h3>Summary</h3>
    <p class="flex flex-wrap gap-x-10">
        <span>Today installs: {{ (installs.days | last).installs|number_format }}</span>
        <span>Last {{ days }} days installs: {{ installs.daysTotal|number_format }}</span>
        <strong>Total installs: {{ installs.total|number_format }}</strong>
    </p>

    <hr />

    <h3>Daily installs per version</h3>

    {% if versions is empty %}
        <p>currently no data available</p>
    {% else %}
        <div data-vue="VersionInstallsChart" data-props="{{ {
            versions: versions|map(version => {
                version: version,
                label: versionLabels[version] ?? version,
                url: path('organization_package_version_stats', {organization: organization.alias, package: package.id, version: version, days: days}),
            }),
        }|json_encode }}">
            <ul class="list-disc pl-5">
                {% for version in versions %}
                    <li>{{ versionLabels[version] ?? version }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}
