{% extends 'base.html.twig' %}

{% block header %}
    {% include 'component/backToPackages.html.twig' %}
    {{ package.name }} details
{% endblock %}
{% block header_btn %}
    {% include 'component/packageActions.html.twig' %}
{% endblock %}

{% block content %}

    {% if package.name %}
        {% if package.isAbandoned %}
            <div class="alert alert-danger">
                {% if package.replacementPackage is not empty %}
                    This package is <b>abandoned</b> and no longer maintained. The author suggests using the <b>{{ package.replacementPackage }}</b> package instead.
                {% else %}
                    This package is <b>abandoned</b> and no longer maintained. No replacement package was suggested.
                {% endif %}
            </div>
        {% endif %}
        <div class="grid gap-x-6 gap-y-2 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <h4>Package name</h4>
                <p class="break-all">{{ package.name }}</p>
            </div>
            <div>
                <h4>Repository URL</h4>
                <p class="break-all"><a href="{{ package.url }}" target="_blank" rel="nofollow noopener noreferrer">{{ package.url }}</a></p>
            </div>
            <div class="sm:col-span-2">
                <h4>Description</h4>
                <p>{{ package.description|striptags }}</p>
            </div>

            <div>
                <h4>Total Installs</h4>
                <p>
                    <a href="{{ path('organization_package_stats', {organization: organization.alias, package: package.id}) }}">
                        {{ installs.total|number_format }}
                    </a>
                </p>
            </div>
            <div>
                <h4>Dependant Packages</h4>
                <p>
                    <a href="{{ path('organization_packages', {organization: organization.alias, search: "depends:"~package.name}) }}">
                        {{ dependantCount|number_format }}
                    </a>
                </p>
            </div>
            <div class="sm:col-span-2">
                <h4>Security</h4>
                <p>{% include 'component/scanBadge.html.twig' %}</p>
            </div>

            {% if package.latestReleaseDate %}
                <div class="sm:col-span-2">
                    <h4>Latest version</h4>
                    <p>
                        {{ package.latestReleasedVersion }} (released:
                        <span title="{{ package.latestReleaseDate|date_time_utc }} ({{ gmt_offset() }})">{{ package.latestReleaseDate|date_time_utc|time_diff }}</span>)
                    </p>
                </div>
                <div class="sm:col-span-2">
                    <h4>Composer require command</h4>
                    {% include 'component/copyInput.html.twig' with {id: 'composer-require', value: 'composer require ' ~ package.name, label: 'Composer require command'} %}
                </div>
            {% endif %}
        </div>

        <hr />

        <h3>Available versions {% if package.keepLastReleases > 0 %}(limited to: {{ package.keepLastReleases }}){% endif %}</h3>

        {% if count == 0 %}
            <p>
                To see available versions of the package, please perform synchronization again.
            </p>
            <button type="button" class="btn btn-success"
                data-confirm-action="{{ path('organization_package_update', {organization: organization.alias, package: package.id }) }}"
                data-confirm-method="POST">
                {% include 'svg/refresh.svg' %} Sync now
            </button>
        {% else %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr>
                        <th>Version</th>
                        <th>Released</th>
                        <th>Reference</th>
                        <th>Size</th>
                        <th><span class="sr-only">Require command</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for version in versions %}
                        <tr>
                            <td data-label="Version">{{ version.version }}</td>
                            <td data-label="Released" class="whitespace-nowrap">
                                <span title="{{ version.date|date_time_utc }} ({{ gmt_offset() }})">
                                    {{ version.date|date_time_utc|time_diff }}
                                </span>
                            </td>
                            <td data-label="Reference" class="font-mono text-xs break-all">{{ version.reference }}</td>
                            <td data-label="Size" class="whitespace-nowrap">{% if version.size > 0 %}{{ version.size | format_bytes }}{% else %}<span class="text-slate-500" title="No archive, Composer installs this version from the repository">source</span>{% endif %}</td>
                            <td class="md:min-w-72">
                                {% include 'component/copyInput.html.twig' with {id: 'version-' ~ loop.index, value: 'composer require ' ~ package.name ~ ':' ~ version.version, label: 'Composer require command for ' ~ version.version} %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'component/pagination.html.twig' with {'path_name': 'organization_package_details', 'path_params': {'organization': organization.alias, 'package': package.id}} %}
        {% endif %}
    {% else %}
        <div class="alert alert-warning">
            This package is not synced yet!
        </div>
    {% endif %}

    {% if packageLinks|length > 0 %}
        <hr />

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {% set types = {
                'requires': 'Requirements',
                'devRequires': 'Dev Requirements',
                'suggests': 'Suggestions',
                'provides': 'Provides',
                'conflicts': 'Conflicts',
                'replaces': 'Replaces',
            } %}

            {% for type,label in types %}
                <div>
                    <h4>{{ label }}</h4>
                    {% if packageLinks[type] is defined and packageLinks[type]|length > 0 %}
                        <ul class="list-disc pl-5 break-words">
                            {% for link in packageLinks[type] %}
                                <li>
                                    {% if link.targetPackageId %}
                                        <a href="{{ path('organization_package_details', {organization: organization.alias, package: link.targetPackageId}) }}">{{ link.target }}</a>: {{ link.constraint }}
                                    {% else %}
                                        {{ link.target }}: {{ link.constraint }}
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <em class="text-slate-500">None</em>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if package.readme() %}
        <hr />

        <h3>README</h3>

        <div class="markdown-body">
            {{ package.readme()|raw }}
        </div>
    {% endif %}

{% endblock %}
