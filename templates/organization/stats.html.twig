{% extends 'base.html.twig' %}

{% set days = days ?? 30 %}

{% block header %}{{ organization.name }} package installs (last {{ days }} days){% endblock %}

{% block header_btn %}
    <label class="sr-only" for="stats-period">Period</label>
    <select id="stats-period" class="form-control w-auto" data-navigate-url="{{ app.request.pathinfo }}?days={value}">
        {% for value, label in {7: 'last 7 days', 30: 'last 30 days', 90: 'last 90 days', 365: 'last year'} %}
            <option value="{{ value }}" {{ days == value ? 'selected' : '' }}>{{ label }}</option>
        {% endfor %}
    </select>
{% endblock %}

{% block installs_chart %}
    <div data-vue="InstallsChart" data-props="{{ {
        name: package is defined ? package.name : 'Installs',
        points: installs.days|map(day => {x: day.date, y: day.installs}),
    }|json_encode }}" class="h-96"></div>
{% endblock %}

{% block content %}
    {{ block('installs_chart') }}

    <hr />

    <h3>Summary:</h3>
    <p>
        Today installs: {{ (installs.days | last).installs|number_format }}<br />
        Last {{ days }} days installs: {{ installs.daysTotal|number_format }}<br />
        <strong>Total installs: {{ installs.total|number_format }}</strong>
    </p>
{% endblock %}
