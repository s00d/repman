{% set current_route = app.request.get('_route') %}
{% macro nav_link(route, params, icon, label, current_route) %}
    <a class="nav-link {{ current_route == route ? 'active' : '' }}" href="{{ path(route, params) }}"{% if current_route == route %} aria-current="page"{% endif %}>
        {% include 'svg/' ~ icon ~ '.svg' %}
        <span>{{ label }}</span>
    </a>
{% endmacro %}
{% import _self as nav %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta name="theme-color" content="#206bc4"/>
    <link rel="icon" href="{{ asset('favicon.ico') }}" type="image/x-icon"/>
    <title>{% block title %}Repman - PHP Repository Manager{% endblock %}</title>
    {% block stylesheets %}
        {{ vite_entry_tags('assets/app.ts') }}
    {% endblock %}
</head>
<body class="{% block body_class %}min-h-screen{% endblock %}">
    {% block body %}
    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-3 px-4 py-2">
            <a href="{{ path('index') }}" class="shrink-0">
                <img src="{{ asset('repman-horizontal.svg') }}" class="h-12" alt="Repman - PHP Repository manager" />
            </a>
            {% block user %}
                {% include 'component/user.html.twig' %}
            {% endblock %}
        </div>
    </header>
    {% block menu %}
    <nav class="border-b border-slate-200 bg-white" aria-label="Main">
        <div class="mx-auto flex max-w-7xl overflow-x-auto px-2 sm:px-4">
            {% if organization is defined %}
                {{ nav.nav_link('organization_overview', {organization: organization.alias}, 'home', 'Overview', current_route) }}
                {{ nav.nav_link('organization_packages', {organization: organization.alias}, 'package', 'Packages', current_route) }}
                {% if is_granted('ROLE_ORGANIZATION_MEMBER', organization) %}
                    {{ nav.nav_link('organization_tokens', {organization: organization.alias}, 'lock', 'Tokens', current_route) }}
                    {{ nav.nav_link('organization_members', {organization: organization.alias}, 'users', 'Members', current_route) }}
                {% endif %}
                {% if is_granted('ROLE_ORGANIZATION_OWNER', organization) %}
                    {{ nav.nav_link('organization_settings', {organization: organization.alias}, 'sliders', 'Settings', current_route) }}
                {% endif %}
            {% else %}
                {{ nav.nav_link('index', {}, 'home', 'Home', current_route) }}
            {% endif %}
        </div>
    </nav>
    {% endblock menu %}
    {% block page %}
    <main class="mx-auto max-w-7xl px-3 py-4 sm:px-4 sm:py-6">
        {% include 'component/flash.html.twig' %}

        <div class="card">
            {% if block('header') is defined %}
                <div class="card-header">
                    <h2 class="card-title">
                        {% block header %}{% endblock %}
                    </h2>
                    <div class="flex flex-wrap items-center gap-2">
                        {% block header_btn %}{% endblock %}
                    </div>
                </div>
            {% endif %}
            <div class="card-body">
                {% block content %}{% endblock %}
            </div>
        </div>
    </main>
    {% endblock page %}
    {% endblock body %}
    {% include 'component/confirmationModal.html.twig' %}

    {% if ga4_tracking is not empty %}
        <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga4_tracking|url_encode }}"></script>
        <script>{% include 'component/js/ga4.js' %}</script>
    {% endif %}
    {% block javascripts %}{% endblock %}
</body>
</html>
