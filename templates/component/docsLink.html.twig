{%- if text is defined -%}
    <a href="https://repman.io/docs/{{ article }}" target="_blank" rel="noreferrer noopener">{{ text }}</a>
{%- else -%}
    <a href="https://repman.io/docs/{{ article }}" target="_blank" rel="noreferrer noopener" title="Documentation"
       class="inline-flex size-4 items-center justify-center rounded-full border border-slate-300 text-[0.65rem] text-slate-500 no-underline hover:border-brand-600 hover:text-brand-600 hover:no-underline">?</a>
{%- endif -%}
