{# column, label: a link that sorts the list by column, again in the other direction once active #}
{% set active = filter.getSortColumn() == column %}
{% set order = active and filter.getSortOrder() == 'asc' ? 'desc' : 'asc' %}
<a href="{{ path(app.request.get('_route'), app.request.get('_route_params') | merge(app.request.query.all) | merge({sort: column ~ ':' ~ order, offset: 0})) }}"
   class="sort-link {{ active ? 'active' : '' }}" title="Sort {{ order == 'asc' ? 'ascending' : 'descending' }}"
   {% if active %}aria-current="true"{% endif %}>
    {{ label }}
    {% if active %}
        {% include filter.getSortOrder() == 'asc' ? 'svg/sort-asc.svg' : 'svg/sort-desc.svg' %}
    {% endif %}
</a>
