{% extends 'base.html.twig' %}

{% block header %}Generate a new API token{% endblock %}

{% block content %}
<div class="max-w-md">
    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="form-row">
            <label for="{{ form.name.vars.id }}" class="form-label required">
                Name {% include 'component/docsLink.html.twig' with {'article': 'api'} %}
            </label>
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
