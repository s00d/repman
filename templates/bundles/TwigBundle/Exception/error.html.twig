{% extends "base.html.twig" %}

{% block body_class %}min-h-screen border-t-4 border-brand-600{% endblock %}

{% block body %}
    <main class="flex min-h-screen flex-col items-center justify-center px-4 text-center">
        <p class="m-0 text-6xl font-light text-slate-400">{{ status_code }}</p>
        <h1 class="mt-3 mb-2 text-xl font-semibold">{% block status_text %}Oops&hellip; You just found an error page{% endblock %}</h1>
        <p class="text-slate-500">
            {% block status_description %}{% endblock %}
        </p>
        {% block button %}
            <a href="{{ path('index') }}" class="btn btn-primary">
                {% include 'svg/arrow-left.svg' %} Take me home
            </a>
        {% endblock %}
    </main>
{% endblock %}
